# Copy to back_end/.env. Secrets live only here, never in front_end/ or VITE_* variables.

# Tavus
TAVUS_API_KEY=
# Optional: `uv run setup-pal` saves the PAL id to .tavus_resources.json, which is used
# when this is empty
TAVUS_PAL_ID=
# Optional: override the PAL's default face
# TAVUS_FACE_ID=
# true = the PAL doesn't join and no minutes are used (plumbing tests only)
TAVUS_TEST_MODE=false
# Seconds; keep test calls short
MAX_CALL_DURATION=180

# Backend
FRONTEND_ORIGIN=http://localhost:5173

# Optional overrides
# INVENTORY_DB_PATH=../ebay_data/inventory.sqlite3
# SEARCH_WINDOW_SIZE=10
# SEARCH_MAX_WINDOWS=5
# SEARCH_MIN_IN_STOCK=5
